# Backend Configuration
# Copy this file to .env and customize as needed

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# Database
DATABASE_PATH=data/swing_trader.db

# Trading Parameters
RISK_PER_TRADE=0.02
MIN_TRADED_VALUE=100000000
MIN_PRICE=50.0

# Screener Parameters
RSI_MIN=55.0
RSI_MAX=70.0
BREAKOUT_THRESHOLD=0.98
VOLUME_MULTIPLIER=1.5

# ATR Multiples
STOP_LOSS_ATR_MULTIPLE=1.0
TARGET_ATR_MULTIPLE=2.0
