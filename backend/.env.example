# Copy to .env and adjust — NEVER commit .env
# Personal local desk defaults (Phase 7). See docs/OPS.md and docs/PERSONAL_USE.md.

DATABASE_PATH=data/swing_trader.db

# --- Personal desk ---
# Auth off = single operator on THIS machine. Do not expose to LAN/WAN.
AUTH_ENABLED=false
SECRET_KEY=dev-only-change-me-swing-desk-32c
LLM_FERNET_KEY=
SESSION_TTL_HOURS=72

# Loopback bind (start.sh exports these). Public bind + auth off is refused unless
# ALLOW_PUBLIC_BIND=true (use only with AUTH / API_KEY and a unique SECRET_KEY).
BIND_HOST=127.0.0.1
ALLOW_PUBLIC_BIND=false

# live only — demo/mock/synthetic are hard-rejected at boot
MARKET_DATA_ADAPTER=live
LIVE_QUOTE_STALE_SEC=5
ALLOW_YAHOO_LTP_FALLBACK=true
BARS_5M_RETENTION_DAYS=45
BARS_5M_YAHOO_RANGE=5d

# Phase 4 — holiday-aware scheduled EOD (IST)
EOD_INGEST_SCHEDULE_ENABLED=true
EOD_INGEST_HOUR_IST=18
EOD_INGEST_MINUTE_IST=45
EOD_SETTLE_HOUR_IST=18
EOD_SETTLE_MINUTE_IST=30
# NSE_HOLIDAYS_FILE=
# NSE_EXTRA_HOLIDAYS=2026-11-01,2026-11-02
MAX_DATA_AGE_DAYS=3
READY_MAX_DATA_AGE_DAYS=1

JURISDICTION_NOTE=Research tooling only. Not registered investment advice in any jurisdiction.

# Kotak Neo Trade API — required for EOD Force full + live WS
KOTAK_CONSUMER_KEY=
KOTAK_MOBILE=+91XXXXXXXXXX
KOTAK_UCC=
KOTAK_MPIN=
# KOTAK_TOTP=
# KOTAK_TOTP_SECRET=
# KOTAK_SESSION_SID=
# KOTAK_SESSION_AUTH=
# KOTAK_HS_SERVER_ID=
# KOTAK_FEED_URL=wss://sfeed.kotaksecurities.com/apifeed

RISK_PER_TRADE=0.02
MIN_TRADED_VALUE=100000000
MIN_PRICE=100.0
MIN_SCORE=65
VOLUME_MULTIPLIER=2.0
RSI_MIN=45
RSI_MAX=75
RS_MIN=3.0
TOP_N=5
MAX_HOLD_DAYS=5
ROUND_TRIP_COST=0.0015
MAX_INGEST_SYMBOLS=0
INGEST_PAUSE_SEC=0.10
INGEST_WORKERS=6

# Empty CORS_ORIGINS → localhost origins only (not *). Set explicitly if needed.
CORS_ORIGINS=
# Optional mutator / expensive-route gate (leave empty for personal loopback UI).
# When set, send header X-API-Key on: ingest, backtest, ledger, journal POST,
# Kotak login/test, POST /api/strategy-evaluation/evaluate, and
# GET /api/strategy-evaluation?run_harness=true. Meta/audit/summary GETs stay open.
# The CRA UI does not send X-API-Key — keep empty locally, or call evaluate via curl.
API_KEY=
# Docs OK on loopback; set false if API is ever network-exposed
ENABLE_API_DOCS=true
LOG_LEVEL=INFO

# LLM keys via Settings UI / PUT /api/me/llm — never commit provider keys.
# Backup DB: ../scripts/backup_sqlite.sh
