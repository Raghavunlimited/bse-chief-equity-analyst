# Copy to .env and adjust — NEVER commit .env

DATABASE_PATH=data/swing_trader.db

# --- Auth / secrets (required for customer MVP) ---
AUTH_ENABLED=true
# Change in any shared or production environment
SECRET_KEY=dev-only-change-me-swing-desk-32c
# Optional dedicated Fernet key (url-safe base64 32-byte). If empty, derived from SECRET_KEY.
LLM_FERNET_KEY=
SESSION_TTL_HOURS=72

# Market data adapter: demo (default, no credentials) | future live adapters
MARKET_DATA_ADAPTER=demo

# Shown in disclosures — not a legal compliance claim
JURISDICTION_NOTE=Research tooling only. Not registered investment advice in any jurisdiction.

# Kotak Neo Trade API — optional live EOD (historical needs only the consumer token)
KOTAK_CONSUMER_KEY=
# KOTAK_BASE_URL=

# --- Strategy / risk ---
RISK_PER_TRADE=0.02
MIN_TRADED_VALUE=100000000
MIN_PRICE=100.0
MIN_SCORE=65
VOLUME_MULTIPLIER=2.0
RSI_MIN=45
RSI_MAX=75
RS_MIN=3.0
TOP_N=5
MAX_HOLD_DAYS=5
ROUND_TRIP_COST=0.0015
MAX_DATA_AGE_DAYS=3
# EOD ingest size. 0 = all NSE EQ cash (~2500). Use 500 for faster refreshes.
MAX_INGEST_SYMBOLS=0
INGEST_PAUSE_SEC=0.10
INGEST_WORKERS=6

# --- Production / readiness ---
CORS_ORIGINS=
API_KEY=
ALLOW_DEMO_DATA=true
ENABLE_API_DOCS=true
LOG_LEVEL=INFO
LOG_FORMAT=text
READY_MAX_DATA_AGE_DAYS=1

# LLM keys are stored per-user encrypted via PUT /api/me/llm — do not put provider keys here.
